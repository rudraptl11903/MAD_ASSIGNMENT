<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background"
    tools:theme="@style/Theme.Material3.Light.NoActionBar">

    <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="60dp" android:layout_marginStart="20dp" android:gravity="center_vertical" android:text="←  My Subjects" android:textColor="@color/blue" android:textSize="20sp" android:textStyle="bold" android:clickable="true" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

    <TextView android:id="@+id/btnClearAll" android:layout_width="wrap_content" android:layout_height="60dp" android:layout_marginEnd="20dp" android:gravity="center_vertical" android:text="Clear All" android:textColor="@color/blue" android:textSize="16sp" android:textStyle="bold" android:clickable="true" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollViewSubjects"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/btnAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/subjectContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="No subjects added yet." android:textColor="@color/gray" android:textSize="16sp"/>
    </ScrollView>

    <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="55dp" android:layout_margin="16dp" android:text="+ ADD SUBJECT" android:textColor="@color/white" android:textStyle="bold" android:backgroundTint="@color/blue" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
